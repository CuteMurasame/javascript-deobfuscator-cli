{
    "name": "js-deobfuscator",
    "version": "1.1.7",
    "description": "A simple but powerful deobfuscator to remove common JavaScript obfuscation techniques",
    "main": "dist/index.js",
    "bin": {
        "js-deobfuscator": "dist/cli.js"
    },
    "types": "dist/index.d.ts",
    "scripts": {
        "start": "tsc && node dist/cli.js",
        "build": "tsc",
        "build:binary": "tsc && pkg dist/cli.js --targets node18-linux-x64 --output build/js-deobfuscator-linux",
        "prepare": "tsc",
        "pretty": "npx prettier --write ."
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "ben-sb-shift-codegen": "^8.0.0",
        "commander": "^9.4.0",
        "estraverse": "^4.2.0",
        "shift-ast": "^6.1.0",
        "shift-parser": "^8.0.0",
        "shift-validator": "^5.0.1",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@types/estraverse": "^5.1.1",
        "@types/node": "^14.14.22",
        "@types/uuid": "^8.3.3",
        "@yao-pkg/pkg": "^5.16.1",
        "ts-loader": "^8.0.14",
        "typescript": "^4.1.3",
        "webpack": "^5.17.0",
        "webpack-cli": "^4.4.0"
    },
    "pkg": {
        "assets": [
            "package.json"
        ]
    }
}
